# Anthropic Claude API 키 (서버에서만 사용, 절대 클라이언트에 노출하지 말 것)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# 실제 호출할 모델 slug. Anthropic 콘솔 Workbench에서 "Get Code"로 확인하는 게 가장 정확합니다.
ANTHROPIC_MODEL=claude-sonnet-5

# (선택) API 키가 특정 워크스페이스에 스코프되지 않아 400 에러
# ("This API key is not scoped to a workspace")가 날 때만 채우세요.
# 콘솔 > Settings > Workspaces 에서 확인 가능한 워크스페이스 ID.
ANTHROPIC_WORKSPACE_ID=

# Supabase 프로젝트 설정값 (보호자 로그인 + 자녀 프로필 + 성장 기록 저장에 사용)
# Supabase 대시보드 상단의 "Connect" 버튼 > App Frameworks > Next.js 에서 그대로 복사하는 걸 추천.
# publishable key는 Anthropic 키와 달리 브라우저에 노출되어도 되는 값입니다 (RLS로 행 단위 보안 처리).
# (예전에는 "anon key"라고 불렀는데, Supabase가 이름을 publishable key로 바꿨습니다.)
# 이 두 값이 없으면 앱이 전부 /login으로 리다이렉트되기만 합니다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
