# Anthropic Claude API 키 (서버에서만 사용, 절대 클라이언트에 노출하지 말 것)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# 실제 호출할 모델 slug. Anthropic 콘솔 Workbench에서 "Get Code"로 확인하는 게 가장 정확합니다.
ANTHROPIC_MODEL=claude-sonnet-5

# (선택) API 키가 특정 워크스페이스에 스코프되지 않아 400 에러
# ("This API key is not scoped to a workspace")가 날 때만 채우세요.
# 콘솔 > Settings > Workspaces 에서 확인 가능한 워크스페이스 ID.
ANTHROPIC_WORKSPACE_ID=
